# ---------------------------------------------------------------------------
# Vorlage für die Umgebungsvariablen.
#
# Lokal:  Diese Datei nach `.env.local` kopieren und ausfüllen.
#         cp .env.example .env.local
#         `.env.local` steht in .gitignore und wird nie committet.
#
# Vercel: Jede Variable einzeln unter
#         Settings -> Environment Variables anlegen
#         (Haken bei Production, Preview und Development).
# ---------------------------------------------------------------------------

# --- Supabase ---------------------------------------------------------------
# Zu finden im Supabase-Dashboard:
#   Project Settings (Zahnrad unten links) -> API

# "Project URL"
NEXT_PUBLIC_SUPABASE_URL=https://ihr-projekt.supabase.co

# "anon / public" key bzw. bei neueren Projekten der "Publishable key"
# (beginnt mit sb_publishable_). Darf im Browser landen, ist durch RLS geschützt.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# "service_role" key bzw. bei neueren Projekten der "Secret key"
# (beginnt mit sb_secret_), im Dashboard hinter "Reveal" versteckt.
#
# ACHTUNG: Umgeht sämtliche Sicherheitsregeln der Datenbank.
# Niemals mit NEXT_PUBLIC_ präfixen, niemals committen, niemals ins Frontend.
# Wird ausschließlich serverseitig in den Route Handlern verwendet.
SUPABASE_SERVICE_ROLE_KEY=

# --- Admin-Bereich ----------------------------------------------------------
# Passwort für /admin. Frei wählbar, bitte lang und zufällig.
ADMIN_PASSWORT=

# Zufälliger Schlüssel zum Signieren des Admin-Cookies.
# Erzeugen mit:  openssl rand -base64 32
ADMIN_SESSION_SECRET=

# --- Sprachmodell -----------------------------------------------------------
# OPTIONAL, und genau das ist der Schalter für die KI.
#
# Ohne diesen Schlüssel läuft die gesamte Demo auf hinterlegten Texten: Sie ist
# vollständig bedienbar, versteht aber keinen Freitext, den die Stichwortsuche
# nicht kennt, und wertet keine Fotos aus. Ist er gesetzt, arbeiten genau die
# Schritte mit einem Modell, die in config/ki-einsatz.ts auf "aktiv" stehen.
# Welche das sind, zeigt /demo/<slug>/leitstand/ki.
#
# Zu finden unter console.anthropic.com -> API Keys. Beginnt mit sk-ant-.
#
# ACHTUNG: Niemals mit NEXT_PUBLIC_ präfixen. Der Schlüssel wird ausschließlich
# serverseitig verwendet (src/lib/ki/zugang.ts) und darf nie im Browser landen.
ANTHROPIC_API_KEY=

# --- Sonstiges --------------------------------------------------------------
# OPTIONAL. Öffentliche Basis-URL für die Demo-Links in der E-Mail-Vorlage.
#
# Leer lassen, solange keine eigene Domain im Spiel ist:
#   - lokal   fällt die Anwendung auf http://localhost:3000 zurück
#   - Vercel  nimmt automatisch die Projekt-URL (z. B. melda.vercel.app)
#
# Eintragen, sobald eine eigene Domain genutzt wird – dann soll im Link an den
# Kunden auch diese Domain stehen. Mit https://, ohne Schrägstrich am Ende.
# Beispiel: https://demo.ihre-domain.de
NEXT_PUBLIC_BASIS_URL=

# OPTIONAL. Ihre Absenderzeile in der E-Mail-Vorlage im Admin-Bereich.
# Mehrzeilig möglich, z. B. "Max Mustermann\nMelda GmbH\n0561 1234567"
ADMIN_ABSENDER=
