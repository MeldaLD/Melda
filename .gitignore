# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files – niemals committen, Ausnahme: die Vorlage
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# supabase cli
/supabase/.temp
/supabase/.branches

# Die Musik selbst gehoert nicht ins Repo. Fuenf Stundenmixe sind schnell ein
# halbes Gigabyte, und sie sind ohnehin auf dem Rechner, auf dem gespielt wird.
/dj/musik/

# Bilder aus den Blick-Werkzeugen (dj:modibilder, dj:mandalabilder).
# Sie werden angesehen und weggeworfen, nicht versioniert.
dj-bilder/

# Standbilder vom Schatten-DJ: erzeugt zum Ansehen, nicht zum Aufheben.
# node dj/werkzeuge/schattenbilder.mjs legt sie neu an.
/dj/werkzeuge/schattenbilder/

# Die Referenzmusik zum Vortanzen wird erzeugt, nicht versioniert.
# npm run dj:vortanzmusik
dj/vortanz/

# Der Pruef-Taenzer wird erzeugt, nicht versioniert.
# npm run dj:prueftaenzer
dj/pruefungen/proben/

# Probefotos von Gaesten fuer die Brillen-Abnahme.
#
# Sie bleiben lokal. Dieses Verzeichnis wird zwar ohnehin nicht ausgeliefert
# (NICHT_AUSLIEFERN in dj/werkzeuge/verteilen.mjs), aber dieses Repository ist
# oeffentlich - "nicht ausgeliefert" heisst hier eben nicht "nicht im Netz".
# Wer die Abnahme laufen lassen will, legt seine eigenen Fotos unter diesen
# Namen ab; fehlen sie, ueberspringt die Abnahme den Teil.
dj/public/brille/proben/gast-*.jpg
